open StatClaim.Interface

/-- The outcome kinds of two-arm models. -/
inductive OutcomeKind where
  | continuous
  | survival
  | binary
  deriving DecidableEq, Repr

/-- The null forms of two-arm outcomes. -/
inductive NullKey where
  | equal_means
  | mean_difference_at_most
  | mean_difference_at_least
  | equal_survival
  | equal_proportions
  | proportion_difference
  | proportion_difference_at_most
  deriving DecidableEq, Repr

/-- The outcome each null form belongs to. -/
def NullKey.outcome : NullKey → OutcomeKind
  | .equal_means => .continuous
  | .mean_difference_at_most => .continuous
  | .mean_difference_at_least => .continuous
  | .equal_survival => .survival
  | .equal_proportions => .binary
  | .proportion_difference => .binary
  | .proportion_difference_at_most => .binary

/-- The shape of each null form; one without a value uses zero. -/
def NullKey.shape : NullKey → NullShape
  | .equal_means => .equal
  | .mean_difference_at_most => .atMost
  | .mean_difference_at_least => .atLeast
  | .equal_survival => .equal
  | .equal_proportions => .equal
  | .proportion_difference => .equal
  | .proportion_difference_at_most => .atMost

/-- Whether a null form takes a value. -/
def NullKey.takesValue : NullKey → Bool
  | .equal_means => false
  | .mean_difference_at_most => true
  | .mean_difference_at_least => true
  | .equal_survival => false
  | .equal_proportions => false
  | .proportion_difference => true
  | .proportion_difference_at_most => true

/-- What a test's minimum sizes count. -/
inductive CountUnit where
  | cluster
  | participant
  deriving DecidableEq, Repr

/-- The observational designs cited tests fit. -/
inductive ObservationalDesign where
  | case_control
  | cohort
  | cross_sectional
  | matched_case_control
  | person_time_cohort
  deriving DecidableEq, Repr

/-- The scales of an observational outcome or exposure. -/
inductive Scale where
  | binary
  | continuous
  deriving DecidableEq, Repr

/-- The sampling designs of an observational study. -/
inductive Survey where
  | cluster
  | simple_random
  | stratified
  | weighted
  deriving DecidableEq, Repr

/-- A cited test of a two-arm trial, as the method registry describes it. -/
structure TrialMethod where
  key : String
  version : Nat
  source : Source
  scope : Scope
  outcome : OutcomeKind
  nulls : List NullKey
  /-- A value the null must have, such as a zero difference. -/
  nullValue : Option ℚ
  minPerArm : Nat
  minTotal : Nat
  /-- What the minimum sizes count. -/
  unit : CountUnit
  assumptions : List String

/-- A cited test of association in an observational study. -/
structure AssociationMethod where
  key : String
  version : Nat
  source : Source
  scope : Scope
  designs : List ObservationalDesign
  outcomeScales : List Scale
  exposureScales : List Scale
  surveys : List Survey
