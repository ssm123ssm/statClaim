{
  "name": "statclaim",
  "displayName": "StatClaim",
  "description": "Statistical language diagnostics, completion, hover, and explicit Lean verification.",
  "publisher": "statclaim-local",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:statclaim",
    "onCommand:statclaim.verifyFile",
    "onCommand:statclaim.restartServer",
    "onCommand:statclaim.explainContract",
    "onCommand:statclaim.showImpact",
    "onView:statclaim.claims"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "statclaim.claims",
          "name": "StatClaim Claims"
        }
      ]
    },
    "languages": [
      {
        "id": "statclaim",
        "aliases": [
          "StatClaim",
          "stat"
        ],
        "extensions": [
          ".stat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "statclaim",
        "scopeName": "source.statclaim",
        "path": "./syntaxes/statclaim.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "statclaim.verifyFile",
        "title": "StatClaim: Verify Current File"
      },
      {
        "command": "statclaim.restartServer",
        "title": "StatClaim: Restart Language Server"
      },
      {
        "command": "statclaim.showClaims",
        "title": "StatClaim: Show Claims"
      },
      {
        "command": "statclaim.explainContract",
        "title": "StatClaim: Explain Contract"
      },
      {
        "command": "statclaim.showImpact",
        "title": "StatClaim: Show Change Impact"
      }
    ],
    "configuration": {
      "title": "StatClaim",
      "properties": {
        "statclaim.uvPath": {
          "type": "string",
          "default": "uv",
          "description": "Path to the uv executable. Reload the extension host after changing."
        },
        "statclaim.projectPath": {
          "type": "string",
          "default": "",
          "description": "StatClaim repository root. Defaults to the workspace root or the development repository. Reload after changing."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check claims-model.js && node --check claims-view.js && node --check test/suite.js && node --check test/run.js",
    "test": "node test/run.js",
    "test:unit": "node --test test/*.test.js",
    "package": "vsce package --out dist/statclaim.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssm123ssm/statClaim.git",
    "directory": "extensions/vscode"
  },
  "extensionKind": [
    "workspace"
  ],
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.8"
    }
  }
}
