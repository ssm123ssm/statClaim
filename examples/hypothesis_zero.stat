# Exactly zero difference is equivalent to equal proportions.
use models.two_arm_binomial
use sampling
use tests.fisher

let study = two_arm_binomial(n_control=100, n_treatment=100)
let plan = fixed(model=study)
let null = proportion_difference(model=study, value=0)
let analysis = fisher(design=plan, null=null, alpha=0.05)
let checked = verify(typeI(analysis))
