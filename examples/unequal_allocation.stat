# Two treated participants for every control (2:1 randomization).
use models.two_arm_binomial
use sampling
use tests.fisher
use planning

let study = two_arm_binomial(n_control=20, n_treatment=40)
let analysis = fisher(design=fixed(model=study), null=equal_proportions(model=study), alpha=1/20)

let target = power_target(
    at=binomial_rates(p_control=1/10, p_treatment=2/5),
    minimum=4/5,
    maximum_typeI=1/20,
)
let candidates = allocated_arm_sizes(
    analysis=analysis,
    min_control=10,
    max_control=40,
    treatment_per_control=2,
)
let sizing = smallest_sample_size(candidates=candidates, target=target)
let recommendation = calculate(sizing)
let verification = verify(sizing)
