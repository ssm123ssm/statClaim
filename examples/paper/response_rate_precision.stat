# From the StatClaim article, "Precision targets". How many participants give a
# 95% interval for a response rate near 30% with a margin of error of at most
# 0.1?
#
# The answer is 89. Precision searches are calculations; Lean does not check
# them.
use tests.binomial
use planning

# One arm with a binary response. 60 is only a starting point; the search below
# tries other sizes.
let arm = one_arm_binomial(n=60)
# The interval to plan: an exact interval for the response rate.
let interval = planned_interval(model=arm, measure="response_rate")
# The target: at a response rate of 30%, a 95% interval whose margin of error,
# half its width, is at most 0.1.
let target = precision_target(at=response_rate(value=3/10),
                              level=19/20, margin_of_error=1/10)
# Candidate sizes from 10 to 2,000.
let sizes = interval_sizes(interval=interval,
                           min_size=10, max_size=2000)
# 89 participants: at the expected count, the interval runs from 0.207 to 0.406,
# a margin of 0.0996. With no assurance requested, precision is judged at the
# expected count.
let needed = calculate(smallest_sample_size(candidates=sizes,
                                           target=target))
