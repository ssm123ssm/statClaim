# Audit Pearson's chi-square rule for unequal fixed binomial arms.
use models.two_arm_binomial
use sampling
use tests.pearson

let study = two_arm_binomial(n_control=4, n_treatment=8)
let design = fixed(model=study)
let null = equal_proportions(model=study)

# The same cutoff and claimed ceiling with two different rejection rules.
let plain = pearson_test(design=design, null=null, squared_cutoff=2401/625, alpha=1/20)
let plain_claim = verify(typeI(plain))

let corrected = pearson_test(
    design=design, null=null, squared_cutoff=2401/625, alpha=1/20, correction="yates",
)
let corrected_claim = verify(typeI(corrected))
