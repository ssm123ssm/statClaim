# Lesson 37: clusters of unequal sizes, by simulation.
use models.two_arm_continuous
use sampling
use tests.cluster
use planning

# The trial of lesson 31: six clinics per arm, twenty patients in each on average.
let clinics = cluster_assignment(clusters_control=6, clusters_treatment=6, n_control=120, n_treatment=120)
let practice = two_arm(assignment=clinics, outcome=continuous_outcome(better="higher"))
let analysis = cluster_t_test(design=fixed(model=practice), null=equal_means(model=practice), alpha=1/20)

# The noncentral t of lesson 31 assumes every clinic has twenty patients.
let equal = power_target(at=mean_difference(value=5, sd=10, icc=1/20), minimum=4/5, maximum_typeI=1/20)
let formula = calculate(meets(analysis=analysis, target=equal))
let simulated = simulate(meets(analysis=analysis, target=equal), seed=2026)

# Real clinics vary: a coefficient of variation of 3/5 in their sizes.
let uneven = power_target(at=mean_difference(value=5, sd=10, icc=1/20, cluster_size_cv=3/5), minimum=4/5, maximum_typeI=1/20)
let varied = simulate(meets(analysis=analysis, target=uneven), seed=2026)

# How many clinics of twenty, on average, when their sizes vary?
let more_clinics = cluster_counts(analysis=analysis, cluster_size=20, min_per_arm=6, max_per_arm=20)
let needed = simulate(smallest_sample_size(candidates=more_clinics, target=uneven), seed=2026)
