# Exact finite-sample checking of an asymptotic binomial likelihood-ratio rule.
use models.two_arm_binomial
use sampling
use tests.likelihood_ratio

let study = two_arm_binomial(n_control=6, n_treatment=10)
let design = fixed(model=study)
let null = equal_proportions(model=study)

# A fitted likelihood ratio above 7 is equivalent to deviance above 2*log(7).
let nominal = likelihood_ratio_test(design=design, null=null, ratio_cutoff=7, alpha=1/20)
let nominal_claim = verify(typeI(nominal))

let audited = likelihood_ratio_test(design=design, null=null, ratio_cutoff=7, alpha=1/10)
let audited_claim = verify(typeI(audited))
