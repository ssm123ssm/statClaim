# Lesson 22: who is analysed, and which outcome.
use models.two_arm_binomial
use sampling
use tests.randomisation
use tests.fisher

# Everyone randomised, analysed in the arm they were assigned to.
let everyone = assignment(
    n_control=40,
    n_treatment=40,
    randomisation="complete",
    population="randomised",
)
let response = two_arm(assignment=everyone, outcome=binary_outcome(better="higher", name="response"))
let primary = randomisation_test(
    design=fixed(model=response),
    null=no_effect(model=response),
    alpha=1/20,
    draws=9999,
)

# Only those who followed the protocol: 6 control and 5 treatment participants left out.
let adherent = two_arm_binomial(
    n_control=34,
    n_treatment=35,
    better="higher",
    population="per_protocol",
    name="response",
)
let supportive = fisher(
    design=fixed(model=adherent),
    null=equal_proportions(model=adherent),
    alpha=1/20,
)

let main = verify(typeI(primary))
let sensitivity = verify(typeI(supportive))
