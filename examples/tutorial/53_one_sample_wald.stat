# Audit the one-sample Wald rule at a low null response rate.
use tests.binomial

let study = one_arm_binomial(n=20)

# The rule uses the observed variance and rejects when it is zero and the difference is nonzero.
let nominal = binomial_wald_test(model=study, null_rate=1/10, squared_cutoff=2401/625, alpha=1/20)
let nominal_claim = verify(typeI(nominal))

let audited = binomial_wald_test(model=study, null_rate=1/10, squared_cutoff=2401/625, alpha=13/100)
let audited_claim = verify(typeI(audited))
