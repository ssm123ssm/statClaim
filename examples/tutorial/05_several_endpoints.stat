# Lesson 5: three endpoints, one overall error rate.
use models.two_arm_binomial
use sampling
use tests.fisher
use multiplicity.bonferroni

let study = two_arm_binomial(n_control=50, n_treatment=50)
let design = fixed(model=study)
let null = equal_proportions(model=study)

let response = fisher(design=design, null=null, alpha=1/40)
let remission = fisher(design=design, null=null, alpha=1/80)
let relapse = fisher(design=design, null=null, alpha=1/80)

let endpoints = bonferroni(
    analyses=[response, remission, relapse],
    alpha=1/20,
    joint_law="binomial_marginals",
)
let verification = verify(familywise(endpoints))
