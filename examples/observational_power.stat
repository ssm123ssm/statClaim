# Exact power of the proved observational tests: Fisher's test of no association when the
# design fixes two groups, McNemar's test for matched pairs, and the rate test given its events.
# Power is the exact probability that the test rejects at a planning point; verify has Lean
# recompute it. Power concerns association: it says nothing about an effect of the exposure.
use models.observational
use sampling
use tests.association
use planning

# A case-control study, planned at the share of controls exposed and the odds ratio.
let study = case_control(cases=50, controls=100, exposure="night shift work", outcome="breast cancer")
let analysis = fisher_exact(design=fixed(model=study), null=no_association(model=study), alpha=1/20)
let target = power_target(
    at=exposure_prevalence(controls=1/5, odds_ratio=3),
    minimum=4/5,
    maximum_typeI=1/20,
)
let proposed = calculate(meets(analysis=analysis, target=target))

# The smallest number of cases in the range, each with two controls.
let sizes = case_control_sizes(analysis=analysis, min_cases=40, max_cases=60, controls_per_case=2)
let smallest = verify(smallest_sample_size(candidates=sizes, target=target))

# A cohort that samples exposed and unexposed groups, planned at the risk in each.
let followed = cohort(exposed=100, unexposed=200, exposure="solvent exposure", outcome="kidney disease")
let test = fisher_exact(design=fixed(model=followed), null=no_association(model=followed), alpha=1/20)
let risk_target = power_target(at=risks(unexposed=1/20, exposed=3/20), minimum=4/5, maximum_typeI=1/20)
let risk_power = calculate(meets(analysis=test, target=risk_target))
let cohorts = cohort_sizes(analysis=test, min_exposed=50, max_exposed=200, unexposed_per_exposed=2)
let exposed_needed = calculate(smallest_sample_size(candidates=cohorts, target=risk_target))

# A 1:1 matched study, planned at the share of discordant pairs and the conditional odds ratio.
let paired = matched_case_control(pairs=60, exposure="benzodiazepine use", outcome="hip fracture")
let pairs_test = mcnemar(design=fixed(model=paired), null=no_association(model=paired), alpha=1/20)
let pairs_target = power_target(
    at=discordant_pairs(share=1/2, odds_ratio=3),
    minimum=4/5,
    maximum_typeI=1/20,
)
let pairs_power = calculate(meets(analysis=pairs_test, target=pairs_target))
let pair_counts = matched_sizes(analysis=pairs_test, min_pairs=55, max_pairs=80)
let fewest_pairs = verify(smallest_sample_size(candidates=pair_counts, target=pairs_target))

# A person-time cohort: power given 100 events, with a quarter of the person-time exposed.
let workers = person_time_cohort(exposure="shift work", outcome="type 2 diabetes")
let rates = rate_test(design=fixed(model=workers), null=no_association(model=workers), alpha=1/40)
let rates_target = power_target(
    at=incidence_rates(rate_ratio=2, exposed_time=8000, unexposed_time=24000, events=100),
    minimum=4/5,
    maximum_typeI=1/40,
)
let rates_power = verify(meets(analysis=rates, target=rates_target))
