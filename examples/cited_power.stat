# Approximate power for cited tests. Each result is a calculation from a normal
# formula, with status calculated: never evidence, and never a bound.
use models.two_arm_continuous
use models.two_arm_binomial
use models.two_arm_survival
use sampling
use tests.t
use tests.logistic
use tests.survival
use planning

# A continuous outcome: a one-sided t-test of non-inferiority, margin -3.
let measured = two_arm_continuous(n_control=200, n_treatment=200)
let pain = t_test_one_sided(
    design=fixed(model=measured),
    null=mean_difference_at_most(model=measured, value=-3),
    alpha=1/40,
)
# The planning point: no true difference, and an SD of 10 for one participant.
let pain_target = power_target(
    at=mean_difference(value=0, sd=10),
    minimum=4/5,
    maximum_typeI=1/40,
)
let pain_power = calculate(meets(analysis=pain, target=pain_target))
let must_exceed = pain_power.calculation.critical_estimate

# The smallest equal arm size in the range that reaches the target.
let pain_sizes = equal_arm_sizes(analysis=pain, min_per_arm=20, max_per_arm=1000)
let pain_size = calculate(smallest_sample_size(candidates=pain_sizes, target=pain_target))

# A yes-or-no outcome: logistic regression, planned as two proportions.
let responders = two_arm_binomial(n_control=150, n_treatment=150)
let response = logistic_regression(
    design=fixed(model=responders),
    null=equal_proportions(model=responders),
    alpha=1/20,
)
let response_target = power_target(
    at=binomial_rates(p_control=3/10, p_treatment=9/20),
    minimum=4/5,
    maximum_typeI=1/20,
)
let response_power = calculate(meets(analysis=response, target=response_target))

# Time to an event: power depends on the expected number of events.
let followed = two_arm_survival(n_control=250, n_treatment=250)
let survival = log_rank(
    design=fixed(model=followed),
    null=equal_survival(model=followed),
    alpha=1/20,
)
let survival_target = power_target(
    at=hazard_ratio(value=7/10, events=250),
    minimum=4/5,
    maximum_typeI=1/20,
)
let survival_power = calculate(meets(analysis=survival, target=survival_target))
