# Regression tests of an exposure with covariates. Guarantees are cited, not proved: the
# compiler checks that each method fits the design, the measurement scales and the null.
use models.observational
use sampling
use tests.regression
use planning

let paired = matched_case_control(pairs=220, exposure="benzodiazepine use", outcome="hip fracture")
let conditional = conditional_logistic(
    design=fixed(model=paired),
    null=no_association(model=paired),
    alpha=1/20,
    adjusted_for=["dementia", "visual impairment"],
)

let workers = person_time_cohort(exposure="solvent exposure", outcome="kidney cancer")
let rates = poisson_rate_regression(
    design=fixed(model=workers),
    null=no_association(model=workers),
    alpha=1/20,
    adjusted_for=["age band", "calendar period"],
)

let followed = cohort(exposed=600, unexposed=1200, exposure="statin use", outcome="dementia")
let risk = modified_poisson(
    design=fixed(model=followed),
    null=no_association(model=followed),
    alpha=1/20,
    adjusted_for=["age", "diabetes"],
)

let conditional_claim = verify(typeI(conditional))
let rates_claim = verify(typeI(rates))
let risk_claim = verify(typeI(risk))

# Power for a measured exposure and outcome: the slope of systolic pressure on BMI.
let clinic = cross_sectional(
    n=250,
    exposure="BMI",
    outcome="systolic pressure",
    exposure_scale="continuous",
    outcome_scale="continuous",
)
let fitted = linear_association(
    design=fixed(model=clinic),
    null=no_association(model=clinic),
    alpha=1/20,
    adjusted_for=["age", "sex"],
)
let target = power_target(
    at=slope(value=1/2, exposure_sd=4, residual_sd=15, exposure_r2=1/10),
    minimum=9/10,
    maximum_typeI=1/20,
)
let power = calculate(meets(analysis=fitted, target=target))
let needed = calculate(
    smallest_sample_size(candidates=total_sizes(analysis=fitted, min_n=10, max_n=5000), target=target),
)

# The same slope unadjusted, if the pressure's error were skewed: its power is simulated,
# and its Type I error judged against Bradley's 3/40.
let unadjusted = linear_association(design=fixed(model=clinic), null=no_association(model=clinic), alpha=1/20)
let skewed = power_target(
    at=slope(value=1/2, exposure_sd=4, residual_sd=15, skewness=2),
    minimum=9/10,
    maximum_typeI=3/40,
)
let skewed_power = simulate(meets(analysis=unadjusted, target=skewed), seed=2026)
