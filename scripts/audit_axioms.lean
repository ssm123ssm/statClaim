import StatClaim
import Lean.Util.CollectAxioms

-- Check transitive dependencies of the milestone theorems, including imports.
-- Unexpected assumptions cause this command, and therefore CI, to fail.
open Lean Elab Command in
run_cmd do
  let allowed := #[``propext, ``Classical.choice, ``Quot.sound]
  let checked := #[
    ``StatClaim.probabilityOrdered_rejection_mass_le,
    ``StatClaim.hypergeometricMass_sum_one,
    ``StatClaim.hypergeometricPValue_eq_weight_ratio,
    ``StatClaim.hypergeometric_rejection_mass_le_targetAlpha,
    ``StatClaim.independentBinomialMass_conditional,
    ``StatClaim.fisherNullRejectionProbability_le_targetAlpha,
    ``StatClaim.fisherNullLaw_real_support,
    ``StatClaim.hypergeometricPValue_eq_of_cross_product,
    ``StatClaim.hypergeometricMass_eq_of_cross_product,
    ``StatClaim.Core.no_compatibility_without_law,
    ``StatClaim.Modules.TwoArmBinomial.law_under_null,
    ``StatClaim.Modules.TwoArmBinomial.proportionDifference_zero_iff,
    ``StatClaim.Modules.Fisher.rejectionEvent_eq,
    ``StatClaim.Modules.Fisher.typeI_statement,
    ``StatClaim.Modules.Fisher.adaptive_requirement_missing,
    ``StatClaim.fisher_typeI_error_le,
    ``StatClaim.fisherNullRejectionProbability_le_alpha,
    ``StatClaim.fisher_typeI_error_le_alpha,
    ``StatClaim.Modules.Bonferroni.strong_control,
    ``StatClaim.Modules.FisherFamily.marginal_bound,
    ``StatClaim.Modules.FisherFamily.marginal_bounds,
    ``StatClaim.Modules.FisherFamily.strong_control,
    ``StatClaim.productBinomial_real_eq_sum,
    ``StatClaim.productBinomial_real_ratPoint,
    ``StatClaim.Core.Policy.law_real_apply,
    ``StatClaim.Core.TypeIGuarantee.toPolicy,
    ``StatClaim.Modules.TwoStageBinomial.rejection_probability,
    ``StatClaim.Modules.TwoStageBinomial.typeI_of_check,
    ``StatClaim.Modules.TwoStageBinomial.power_of_check,
    ``StatClaim.Modules.FisherPower.checkedReject_iff,
    ``StatClaim.Modules.FisherPower.rejection_probability,
    ``StatClaim.Modules.FisherPower.power_of_check,
    ``StatClaim.Modules.FisherPower.typeI_statement,
    ``StatClaim.binomialExpectation_mono,
    ``StatClaim.binomial_real_mono,
    ``StatClaim.productBinomial_real_mono,
    ``StatClaim.Modules.OneSampleBinomial.typeI_of_check,
    ``StatClaim.Modules.OneSampleBinomial.power_of_check,
    ``StatClaim.Modules.TwoStageBinomial.typeI_atMost_of_check,
    ``StatClaim.Modules.TwoStageBinomial.thresholdDesign_monotone,
    ``StatClaim.Modules.FisherPower.rejectionNumerator_hint,
    ``StatClaim.Modules.FisherPower.power_lt_of_smallerFail,
    ``StatClaim.Modules.FisherPower.smallerFail_of_hinted,
    ``StatClaim.Modules.OneSampleBinomial.fails_of_smallerFail,
    ``StatClaim.Modules.FisherFamilyN.strong_control,
    ``StatClaim.Modules.OneSampleBinomial.pValue_eq_of_cross_product,
    ``StatClaim.Modules.BinomialInterval.coverage,
    ``StatClaim.Modules.BinomialInterval.interval_contains,
    ``StatClaim.Modules.TwoStageBinomial.posteriorDesign_monotone,
    ``StatClaim.Modules.BinomialInterval.joint_coverage,
    ``StatClaim.Modules.BinomialInterval.difference_contains,
    ``StatClaim.lowerTail_rejection_mass_le,
    ``StatClaim.conditionalTest_rejection_le,
    ``StatClaim.productBinomial_real_mono_right,
    ``StatClaim.Modules.FisherOneSided.boundary_le,
    ``StatClaim.Modules.FisherOneSided.typeI_of_hints,
    ``StatClaim.Modules.FisherOneSided.power_of_check,
    ``StatClaim.Modules.FisherOneSided.power_lt_of_smallerFail,
    ``StatClaim.Modules.FisherOneSided.lowerPValue_eq_of_cross_product,
    ``StatClaim.productBinomial_real_le_corner,
    ``StatClaim.Modules.DifferenceTest.thresholdNumerator_eq,
    ``StatClaim.Modules.DifferenceTest.cell_exists,
    ``StatClaim.Modules.DifferenceTest.typeI_of_cells,
    ``StatClaim.Modules.DifferenceTest.power_of_check,
    ``StatClaim.Modules.Composition.familywise_le,
    ``StatClaim.Modules.Composition.familywise_le_of_levels,
    ``StatClaim.Modules.Composition.fixed_sequence_le,
    ``StatClaim.Modules.Composition.fixed_sequence_le_of_levels,
    ``StatClaim.Modules.Randomisation.card_rejected_le,
    ``StatClaim.Modules.Randomisation.uniform_tail_le,
    ``StatClaim.Modules.Randomisation.uniform_univ,
    ``StatClaim.Modules.Randomisation.splits_card,
    ``StatClaim.Modules.Randomisation.law_univ,
    ``StatClaim.Modules.Randomisation.sharpNull_of_units,
    ``StatClaim.Modules.Randomisation.pValue_ge,
    ``StatClaim.Modules.Randomisation.typeI,
    ``StatClaim.Modules.Randomisation.typeI_of_level,
    ``StatClaim.Modules.Randomisation.uniformRejection_le,
    ``StatClaim.Modules.Randomisation.groupedSplits_card,
    ``StatClaim.Modules.Randomisation.groupedSplits_nonempty,
    ``StatClaim.Modules.Randomisation.groupedLaw_univ,
    ``StatClaim.Modules.Randomisation.groupedTypeI_of_level,
    ``StatClaim.Modules.Randomisation.card_filter_perm,
    ``StatClaim.Modules.Randomisation.rejectedAt_card,
    ``StatClaim.Modules.Randomisation.card_drawn_le,
    ``StatClaim.Modules.Randomisation.pi_uniform,
    ``StatClaim.Modules.Randomisation.drawnRejection_le,
    ``StatClaim.Modules.Randomisation.drawnRejection_le_of_level,
    ``StatClaim.Modules.Randomisation.drawnShare_ge,
    ``StatClaim.Modules.Association.groups_typeI_le_alpha,
    ``StatClaim.Modules.Association.mixtureLaw_univ,
    ``StatClaim.Modules.Association.mixture_typeI_le_alpha,
    ``StatClaim.Modules.Association.mixture_joint_coverage,
    ``StatClaim.Modules.Association.ratio_contains,
    ``StatClaim.Modules.Association.odds_ratio_contains,
    ``StatClaim.Modules.Matched.level,
    ``StatClaim.Modules.Matched.typeI,
    ``StatClaim.Modules.Matched.pairs_coverage,
    ``StatClaim.Modules.Matched.odds_contains]
  for theoremName in checked do
    match ← getConstInfo theoremName with
    | .thmInfo _ => pure ()
    | _ => throwError "Expected a theorem: {theoremName}"
    let dependencies ← collectAxioms theoremName
    for dependency in dependencies do
      unless allowed.contains dependency do
        throwError "Unexpected assumption {dependency} in {theoremName}"
    logInfo m!"Checked {theoremName}: {dependencies}"
